<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>URL Collection App</display-name>

    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>webapp.controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/LoginController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>webapp.controller.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/LogoutController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UrlController</servlet-name>
        <servlet-class>webapp.controller.UrlController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UrlController</servlet-name>
        <url-pattern>/UrlController</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TopController</servlet-name>
        <servlet-class>webapp.controller.TopController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TopController</servlet-name>
        <url-pattern>/TopController</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>