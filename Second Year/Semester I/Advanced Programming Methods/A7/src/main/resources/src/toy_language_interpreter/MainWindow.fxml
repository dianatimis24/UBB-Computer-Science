<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.gui.MainWindowController">
   <children>
      <VBox layoutX="14.0" layoutY="14.0" prefHeight="373.0" prefWidth="576.0" spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <HBox alignment="CENTER" prefHeight="56.0" prefWidth="560.0">
               <children>
                  <Label text="Number of Program States:">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </Label>
                  <TextField fx:id="numberOfProgramStatesTextField" editable="false">
                     <font>
                        <Font size="16.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </TextField>
               </children>
            </HBox>
            <HBox prefHeight="288.0" prefWidth="560.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="HEAP TABLE" textAlignment="CENTER" />
                        <TableView fx:id="heapTableView" prefHeight="200.0" prefWidth="200.0">
                           <columns>
                              <TableColumn fx:id="heapAddressColumn" prefWidth="99.5" text="Address" />
                              <TableColumn fx:id="heapValueColumn" prefWidth="106.0" text="Value" />
                           </columns>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </TableView>
                        <Label text="OUTPUT" />
                        <ListView fx:id="outputListView" prefHeight="200.0" prefWidth="200.0" />
                        <Label text="FILE TABLE" />
                        <ListView fx:id="fileTableListView" prefHeight="200.0" prefWidth="200.0" />
                     </children>
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="PROGRAM STATE IDENTIFIERS" />
                        <ListView fx:id="programStateIdentifiersListView" prefHeight="103.0" prefWidth="280.0" />
                        <Label text="SYMBOL TABLE" />
                        <TableView fx:id="symbolTableView" prefHeight="161.0" prefWidth="280.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="symbolTableVariableNameColumn" prefWidth="102.0" text="Variable Name" />
                              <TableColumn fx:id="symbolTableValueColumn" prefWidth="110.0" text="Value" />
                           </columns>
                        </TableView>
                        <Label text="EXECUTION STACK" />
                        <ListView fx:id="executionStackListView" prefHeight="131.0" prefWidth="275.0" />
                     </children>
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
            <Button fx:id="runOneStepButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#runOneStep" text="RUN ONE STEP" textAlignment="CENTER" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
